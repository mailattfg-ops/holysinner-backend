# Copy to .env. Everything is optional for local dev: with no DATABASE_URL the API uses embedded PGlite in .pglite/
# Supabase → Project Settings → Database → Connection pooling (transaction mode, port 6543)
DATABASE_URL=
PORT=8787
# 32+ random chars in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JOBS_SECRET=
CORS_ORIGIN=http://localhost:5173
